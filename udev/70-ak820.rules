# AJAZZ / Epomaker AK820 Pro — let the logged-in user open its hidraw nodes.
# Must sort before systemd's 73-seat-late.rules, or the uaccess tag is applied too late.
# Install: sudo cp 70-ak820.rules /usr/lib/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="800a", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="ak820-clock.service"
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="8009", TAG+="uaccess", TAG+="systemd", ENV{SYSTEMD_USER_WANTS}+="ak820-clock.service"
# 2.4 GHz dongle — cannot reach the screen, but keep the node usable for GET_DEVICE_INFO
KERNEL=="hidraw*", ATTRS{idVendor}=="0c45", ATTRS{idProduct}=="fefe", TAG+="uaccess"
